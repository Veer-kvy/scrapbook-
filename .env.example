# Copy to .env.local and fill in with your Supabase project values.
# The anon key is safe for the browser ONLY because row-level security is on.
# Never put the service-role key in a VITE_ variable — it would ship to visitors.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Optional, defaults to scrapbook-media
VITE_SUPABASE_BUCKET=scrapbook-media
